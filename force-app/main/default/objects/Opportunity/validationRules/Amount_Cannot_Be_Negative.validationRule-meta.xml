<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Amount_Cannot_Be_Negative</fullName>
    <active>true</active>
    <description>US-0000032: block saving an Opportunity whose Amount is negative. A zero or blank Amount is allowed.</description>
    <errorConditionFormula>Amount &lt; 0</errorConditionFormula>
    <errorDisplayField>Amount</errorDisplayField>
    <errorMessage>Amount cannot be negative.</errorMessage>
</ValidationRule>
